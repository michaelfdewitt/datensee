{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:datensee:contract:pipeline-config",
  "title": "PipelineConfig",
  "description": "Contract between the Python CLI and the Java Beam pipeline. The `pipeline_kind` discriminator + nested payload let the Java side dispatch on what shape of work it's being asked to do. Today only `pipeline_kind=\"pixel\"` is implemented; a future vector pipeline will add `\"vector\"` as a sibling payload.",
  "type": "object",
  "required": [
    "ee_expression",
    "gee_project",
    "pixel"
  ],
  "additionalProperties": false,
  "properties": {
    "pipeline_kind": {
      "type": "string",
      "enum": [
        "pixel"
      ],
      "default": "pixel",
      "description": "Discriminator selecting which payload shape applies."
    },
    "ee_expression": {
      "type": "string",
      "description": "Serialized Earth Engine computation (opaque JSON string). Never interpreted by the pipeline."
    },
    "gee_project": {
      "type": "string",
      "description": "GCP project ID with Earth Engine API enabled. Used in the HV API URL."
    },
    "pixel": {
      "type": "object",
      "description": "Pixel-pipeline payload. Required when pipeline_kind=\"pixel\".",
      "required": [
        "tile_grid",
        "output"
      ],
      "additionalProperties": false,
      "properties": {
        "tile_grid": {
          "type": "object",
          "required": [
            "pixel_grid"
          ],
          "additionalProperties": false,
          "properties": {
            "pixel_grid": {
              "type": "object",
              "description": "Parent PixelGrid (mirrors EE's PixelGrid type). Tiles inside the export are integer pixel rectangles within this grid.",
              "required": [
                "crs_code",
                "affine_transform",
                "dimensions"
              ],
              "additionalProperties": false,
              "properties": {
                "crs_code": {
                  "type": "string",
                  "description": "EPSG code or proj string, e.g. 'EPSG:4326'."
                },
                "affine_transform": {
                  "type": "object",
                  "description": "Geo-affine in EE / GDAL / GeoTIFF convention. scale_y is conventionally negative (NW-corner origin).",
                  "required": [
                    "scale_x",
                    "translate_x",
                    "scale_y",
                    "translate_y"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "scale_x": {
                      "type": "number"
                    },
                    "shear_x": {
                      "type": "number",
                      "default": 0
                    },
                    "translate_x": {
                      "type": "number"
                    },
                    "shear_y": {
                      "type": "number",
                      "default": 0
                    },
                    "scale_y": {
                      "type": "number"
                    },
                    "translate_y": {
                      "type": "number"
                    }
                  }
                },
                "dimensions": {
                  "type": "object",
                  "required": [
                    "width",
                    "height"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "width": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            },
            "tile_size_pixels": {
              "type": "integer",
              "minimum": 1,
              "default": 512,
              "description": "Compute tile edge length in pixels."
            },
            "tiles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "col_px",
                  "row_px",
                  "width_px",
                  "height_px",
                  "row",
                  "col"
                ],
                "additionalProperties": false,
                "properties": {
                  "col_px": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "row_px": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "width_px": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height_px": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "row": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "col": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "out_row": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "out_col": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "lineage": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3
                    }
                  }
                }
              }
            },
            "tiles_file": {
              "type": "string",
              "description": "GCS URI or local path to NDJSON file of tile coordinates. Mutually exclusive with 'tiles'."
            }
          },
          "oneOf": [
            {
              "required": [
                "tiles"
              ]
            },
            {
              "required": [
                "tiles_file"
              ]
            }
          ]
        },
        "output": {
          "type": "object",
          "required": [
            "output_path"
          ],
          "additionalProperties": false,
          "properties": {
            "output_path": {
              "type": "string",
              "description": "Output path: GCS URI prefix (gs://…) or local directory."
            },
            "band_count": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "description": "Number of output bands."
            },
            "data_type": {
              "type": "string",
              "enum": [
                "float32",
                "float64",
                "int16",
                "int32",
                "uint8",
                "uint16"
              ],
              "default": "float32",
              "description": "Pixel data type for the output raster."
            },
            "output_tile_size_pixels": {
              "type": "integer",
              "minimum": 1,
              "description": "two-tier output tile edge in pixels (must be a multiple of tile_size_pixels)."
            },
            "merge_existing_output": {
              "type": "boolean",
              "default": false,
              "description": "two-tier retry semantics: when true, the assembler decodes an already-existing output COG as the baseline canvas and overlays this run's tiles (including quadtree split children) onto it. Set by `datensee retry`; fresh exports leave this false so stale files are replaced, never blended into."
            },
            "nodata": {
              "type": "number",
              "description": "Optional nodata value written as the GDAL_NODATA tag on every output COG. EE returns masked pixels as 0 with no mask channel; unmask(sentinel) the expression and declare the sentinel here."
            },
            "compression": {
              "type": "string",
              "enum": [
                "deflate",
                "none"
              ],
              "default": "deflate",
              "description": "COG compression — the transcoder's only knob (no overviews, no predictor; block size is always the compute tile size)."
            }
          }
        }
      }
    },
    "snapshot_time": {
      "type": "integer",
      "description": "Unix microseconds at which all asset references in ee_expression were pinned. Workers see a consistent view of mutable assets. Diagnostic only on the Java side — pinning is already baked into ee_expression by the CLI. Microseconds is the unit EE's `version` load argument expects; pre-fix exports stored this as nanoseconds, which causes EE INTERNAL crashes."
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "local",
            "dataflow"
          ],
          "default": "local"
        },
        "dataflow": {
          "type": "object",
          "required": [
            "project",
            "region",
            "temp_location",
            "staging_location"
          ],
          "additionalProperties": false,
          "properties": {
            "project": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "temp_location": {
              "type": "string",
              "pattern": "^gs://"
            },
            "staging_location": {
              "type": "string",
              "pattern": "^gs://"
            },
            "machine_type": {
              "type": "string",
              "default": "n2-standard-4"
            },
            "num_workers": {
              "type": "integer",
              "minimum": 1,
              "default": 4,
              "description": "Initial worker count. Dataflow's batch autoscaler is reactive, so booting non-trivially reaches steady-state throughput faster than starting from 1."
            },
            "max_workers": {
              "type": "integer",
              "minimum": 1,
              "default": 100
            },
            "autoscaling_algorithm": {
              "type": "string",
              "enum": [
                "THROUGHPUT_BASED",
                "NONE"
              ],
              "default": "THROUGHPUT_BASED",
              "description": "Dataflow autoscaling mode. Pinned to THROUGHPUT_BASED by default so behavior doesn't drift with the runner."
            },
            "number_of_worker_harness_threads": {
              "type": "integer",
              "minimum": 1,
              "default": 8,
              "description": "Per-worker fetcher concurrency. Sized above vCPU count because tile fetches are I/O-bound."
            },
            "service_account_email": {
              "type": "string"
            },
            "network": {
              "type": "string"
            },
            "subnetwork": {
              "type": "string"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Dataflow job labels, forwarded as --labels=JSON. Useful for filtering jobs.list queries."
            }
          }
        }
      }
    },
    "carryover_file": {
      "type": "string",
      "description": "GCS URI or local path of a carryover journal staged by `datensee retry`: the previous round's no-progress records (terminal kinds, depth-capped splits), stamped with journal_reason. The pipeline unions these lines with this run's fresh failures when writing _failures.json."
    }
  }
}
